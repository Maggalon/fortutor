# Copy to PROJECT_ROOT/.env.production; chmod 600. Never commit real values.
COMPOSE_PROJECT_NAME=fortutor
PROXY_NETWORK=proxy
PROXY_ALIAS=fortutor
WEB_IMAGE=fortutor-web:0000000000000000000000000000000000000000
WORKER_IMAGE=fortutor-worker:0000000000000000000000000000000000000000
# Use hex passwords (openssl rand -hex 32) so URLs need no percent encoding.
POSTGRES_PASSWORD=replace_with_random_hex_password
REDIS_PASSWORD=replace_with_another_random_hex_password
APP_URL=https://for-tutor.ru
DEMO_MODE=false
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Optional HTTP CONNECT proxy for Telegram API and Telegram file downloads only.
# Example: http://USER:PASSWORD@HOST:PORT (URL-encode credentials).
TELEGRAM_PROXY_URL=
MAX_BOT_TOKEN=
MAX_BOT_URL=
MAX_API_URL=https://platform-api2.max.ru
MAX_WEBHOOK_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_URL=https://api.deepseek.com
# Optional for the first deployment. Leave BOTH keys empty until the shop is ready.
# Registration/trial access work without YooKassa; payments are disabled.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST_MODE=false
YOOKASSA_RECEIPTS=false
YOOKASSA_VAT_CODE=
YOOKASSA_TAX_SYSTEM_CODE=
